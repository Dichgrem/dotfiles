{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_DAEMON_IDLE_TIMEOUT_MS": "1800000"
      },
      "timeout": 300,
      "exposure": "direct"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "xxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "exposure": "direct"
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": "xxxxxxxxxxxxxxxxxxxxxxxxxx"
      }
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    },
    "officecli": {
      "command": "C:\\Users\\Admin\\.npm-global\\node_modules\\@officecli\\officecli\\vendor\\officecli.exe",
      "args": [
        "mcp"
      ],
      "exposure": "direct"
    }
  }
}
